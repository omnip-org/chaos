# =============================================================================
# Production environment template.
#
# Copy the filled-in version into the GitHub Actions secret `PRODUCTION_ENV`
# (Settings -> Secrets and variables -> Actions). deploy.yml writes it to
# /opt/chaos/.env (chmod 600, git-ignored) on the host before each rollout.
#
# Generate strong secrets with:  openssl rand -base64 48
# NEVER commit a filled-in copy of this file.
# =============================================================================

# --- Networking (leave as-is; the Caddy gateway maps the public port) --------
APP_BIND_ADDR=0.0.0.0:8080

# --- Database (REQUIRED) -----------------------------------------------------
# Hosts are the in-cluster compose service names (postgres/redis), not external
# addresses. The `chaos` login assumes the NOLOGIN runtime/control-plane roles
# after connecting. URL-encode the password in both connection URLs.
POSTGRES_PASSWORD=CHANGE_ME_STRONG
DATABASE_URL=postgres://chaos:CHANGE_ME_URL_ENCODED@postgres:5432/chaos
DATABASE_CONTROL_PLANE_URL=postgres://chaos:CHANGE_ME_URL_ENCODED@postgres:5432/chaos
DATABASE_RUNTIME_ROLE=chaos_runtime
DATABASE_CONTROL_PLANE_ROLE=chaos_control_plane
# Tune pools to the instance size:
DATABASE_CONTROL_PLANE_MAX_CONNECTIONS=5
DATABASE_ANALYTICS_MAX_CONNECTIONS=3
DATABASE_ANALYTICS_STATEMENT_TIMEOUT_MS=2000

# --- Redis (REQUIRED) --------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- WebAuthn / auth (REQUIRED, must match your real domain) -----------------
# RP_ID is the registrable domain; RP_ORIGIN must be https and match it.
WEBAUTHN_RP_ID=shop.example.com
WEBAUTHN_RP_ORIGIN=https://shop.example.com
AUTH_PUBLIC_BASE_URL=https://shop.example.com

# --- Email (REQUIRED) --------------------------------------------------------
# Either a real SMTP server ...
SMTP_URL=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=Chaos <no-reply@example.com>
# ... or Resend (set BOTH or NEITHER; keep SMTP_URL as fallback if unused):
# RESEND_API_KEY=re_xxx
# RESEND_WEBHOOK_SECRET=whsec_xxx

# --- testpay HMAC secret (REQUIRED to boot) ----------------------------------
# NOTE: this is NOT the Stripe webhook secret. It only verifies the built-in
# "testpay" sandbox payment provider (HmacPaymentWebhookVerifier). Real Stripe
# webhook secrets are per-merchant and configured separately (see below). It is
# `required`, so give it a random value even if you never use testpay.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_base64_48

# --- Shopper token signing (REQUIRED, >= 32 random bytes) --------------------
# Rotate via SHOPPER_TOKEN_PREVIOUS_* during an overlap window.
SHOPPER_TOKEN_ACTIVE_KEY_ID=v1
SHOPPER_TOKEN_ACTIVE_SECRET=CHANGE_ME_openssl_rand_base64_48
# SHOPPER_TOKEN_PREVIOUS_KEY_ID=v0
# SHOPPER_TOKEN_PREVIOUS_SECRET=old-secret-kept-during-rotation

# --- Provider secret encryption key (REQUIRED, exactly 32 raw bytes, base64) -
# Encrypts Payment/Shipping/Analytics Provider Key credentials at rest in
# PostgreSQL (AES-256-GCM) and decrypts them at request time. Generate with:
#   openssl rand -base64 32
# Losing this key makes every stored Provider Key permanently unrecoverable
# (there is no rotation/re-encryption tooling) — back it up like you would the
# database itself, and keep it as sensitive as the DB credentials above.
CHAOS_PROVIDER_SECRET_KEY=CHANGE_ME_openssl_rand_base64_32

# =============================================================================
# Real third-party provider secrets (referenced from the DB).
#
# These are NOT read by name at startup. A Provider/Store account is configured
# through the Admin API with an opaque `env://...` or `enc://...` reference.
# Environment references remain useful for shared platform credentials, but a
# new environment variable requires a rolling restart. `enc://` references are
# AES-256-GCM ciphertext stored directly in PostgreSQL, decrypted at request
# time with CHAOS_PROVIDER_SECRET_KEY above, and support Store onboarding
# without a restart.
#
# The secret resolver is a replaceable port; the built-in encrypted-at-rest
# adapter can be superseded by another secret-manager adapter without changing
# the use cases. Submit new Provider Keys through the Admin API — it returns
# the generated `enc://...` reference once, with Cache-Control: no-store.
# =============================================================================

# Stripe Connect. A platform credential may be shared by many connected
# accounts; each Store still records its own external acct_* reference.
#   credential secret  -> JSON {"secret_key":"sk_live_...","publishable_key":"pk_live_..."}
#   webhook secret     -> the raw Stripe endpoint signing secret (whsec_...)
# CHAOS_PAYMENT_SECRET_ACME={"secret_key":"sk_live_xxx","publishable_key":"pk_live_xxx"}
# CHAOS_PAYMENT_SECRET_ACME_WEBHOOK=whsec_xxx

# EasyPost shipping (per Store account). Outbound only, no inbound webhook secret.
# CHAOS_SHIPPING_SECRET_ACME=EZAK_live_xxx

# Analytics destinations (Meta / GA4), referenced from the Admin API.
# CHAOS_ANALYTICS_SECRET_META_PRIMARY=xxx
# CHAOS_ANALYTICS_SECRET_GA4_PRIMARY=xxx

# --- Optional: media storage (S3-compatible); all five required together -----
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_BUCKET=chaos-media
# MEDIA_S3_ACCESS_KEY_ID=xxx
# MEDIA_S3_SECRET_ACCESS_KEY=xxx
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/
# MEDIA_S3_ENDPOINT_URL=https://s3.example.com   # non-AWS providers
# MEDIA_S3_FORCE_PATH_STYLE=true

# --- Optional: tracing -------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Observability / runtime (safe defaults) ---------------------------------
RUST_LOG=chaos=info,chaos_api=info,tower_http=warn
LOG_JSON=true
SHUTDOWN_DRAIN_DELAY_MS=5000
SHUTDOWN_WORKER_TIMEOUT_MS=30000
