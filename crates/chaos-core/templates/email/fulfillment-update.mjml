{% extends "base.mjml" %}
{% if status == "delivered" %}
  {% set label = "Delivery update" %}
  {% set headline = "Your order has arrived" %}
  {% set body = "Order " ~ order_number ~ " has been delivered. We hope you enjoy it." %}
{% else %}
  {% set label = "Shipping update" %}
  {% set headline = "Your order is on its way" %}
  {% set body = "Order " ~ order_number ~ " has shipped and is on its way to you." %}
{% endif %}
{% block title %}{{ brand.name }} · {{ headline }}{% endblock %}
{% block preheader %}{{ body }}{% endblock %}
{% block content %}
<mj-section background-color="{{ brand.surface_color }}" padding="8px 24px 24px">
  <mj-column>
    <mj-text color="{{ brand.muted_text_color }}" font-size="12px" font-weight="600" padding="0 0 4px">{{ label }}</mj-text>
    <mj-text color="{{ brand.text_color }}" font-size="22px" font-weight="700" line-height="29px" padding="0 0 12px">{{ headline }}</mj-text>
    <mj-text padding="0">{{ body }}</mj-text>
  </mj-column>
</mj-section>

{% if tracking_number %}
<mj-section background-color="{{ brand.surface_color }}" padding="0 24px 24px">
  <mj-column>
    <mj-divider border-width="1px" border-color="{{ brand.accent_color }}" padding="0 0 16px" />
    <mj-text color="{{ brand.muted_text_color }}" font-size="12px" font-weight="600" padding="0 0 4px">Tracking</mj-text>
    <mj-text padding="0">
      {% if tracking_url %}<a href="{{ tracking_url }}" style="color:{{ brand.primary_color }};font-weight:600;text-decoration:underline">{{ tracking_number }}</a>{% else %}<strong>{{ tracking_number }}</strong>{% endif %}
    </mj-text>
  </mj-column>
</mj-section>
{% endif %}

{% include "components/order-status-button.mjml" %}
{% endblock %}
