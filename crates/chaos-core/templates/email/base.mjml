<mjml lang="en">
  <mj-head>
    <mj-title>{% block title %}{{ brand.name }}{% endblock %}</mj-title>
    <mj-preview>{% block preheader %}{% endblock %}</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text color="{{ brand.text_color }}" font-size="15px" line-height="25px" padding="0" />
      <mj-button background-color="{{ brand.primary_color }}" color="#FFFFFF" border-radius="6px" font-size="14px" font-weight="600" inner-padding="13px 22px" />
      <mj-class name="section-title" color="{{ brand.text_color }}" font-size="17px" font-weight="600" line-height="26px" />
    </mj-attributes>
    <mj-style>
      .letter-sheet { box-shadow: 0 12px 32px rgba(41, 37, 36, 0.07); }
      @media only screen and (max-width: 480px) {
        .letter-pad > table > tbody > tr > td { padding-left: 24px !important; padding-right: 24px !important; }
        .mobile-hide { display: none !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body width="600px" background-color="{{ brand.background_color }}">
    <mj-section padding="20px 0 10px">
      <mj-column><mj-spacer height="1px" /></mj-column>
    </mj-section>

    <mj-wrapper css-class="letter-sheet" background-color="{{ brand.surface_color }}" padding="0">
      <mj-section background-color="{{ brand.surface_color }}" padding="28px 40px 22px" css-class="letter-pad">
        <mj-column>
          <mj-table padding="0">
            <tr>
              {% if brand.logo_url %}
              <td width="44" style="width:44px;padding:0 12px 0 0;vertical-align:middle">
                <img src="{{ brand.logo_url }}" alt="{{ brand.name }}" width="32" height="32" style="display:block;width:32px;height:32px;border:0;border-radius:6px;object-fit:contain" />
              </td>
              {% endif %}
              <td style="padding:0;color:{{ brand.text_color }};font-size:16px;font-weight:600;line-height:32px;vertical-align:middle">{{ brand.name }}</td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section background-color="{{ brand.surface_color }}" padding="0 40px" css-class="letter-pad">
        <mj-column>
          <mj-divider border-width="2px" border-color="{{ brand.primary_color }}" padding="0" />
        </mj-column>
      </mj-section>

      {% block content %}{% endblock %}

      <mj-section background-color="{{ brand.surface_color }}" padding="4px 40px 34px" css-class="letter-pad">
        <mj-column>
          <mj-divider border-width="1px" border-color="{{ brand.accent_color }}" padding="0 0 18px" />
          <mj-text color="{{ brand.muted_text_color }}" font-size="12px" line-height="20px">
            Questions about your order? Reply to this email and our team will help.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="18px 24px 30px">
      <mj-column>
        <mj-text align="center" color="{{ brand.muted_text_color }}" font-size="11px" line-height="17px">
          Sent by {{ brand.name }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
