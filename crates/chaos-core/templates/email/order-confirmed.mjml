{% extends "base.mjml" %}
{% block title %}{{ brand.name }} · Order {{ order_number }} confirmed{% endblock %}
{% block preheader %}Your payment for order {{ order_number }} was received.{% endblock %}
{% block content %}
<mj-section background-color="{{ brand.surface_color }}" padding="8px 24px 24px">
  <mj-column>
    <mj-text color="{{ brand.muted_text_color }}" font-size="12px" font-weight="600" padding="0 0 4px">Order {{ order_number }}</mj-text>
    <mj-text color="{{ brand.text_color }}" font-size="22px" font-weight="700" line-height="29px" padding="0 0 12px">Your order is confirmed</mj-text>
    <mj-text padding="0">We've received your payment and are getting it ready.</mj-text>
  </mj-column>
</mj-section>

<mj-section background-color="{{ brand.surface_color }}" padding="0 24px 24px">
  <mj-column>
    <mj-table padding="0">
      <thead>
        <tr>
          <th colspan="2" align="left" style="padding:0 0 8px;border-bottom:1px solid {{ brand.accent_color }};font-size:12px;color:{{ brand.muted_text_color }};font-weight:600">Item</th>
          <th align="center" style="padding:0 8px 8px;border-bottom:1px solid {{ brand.accent_color }};font-size:12px;color:{{ brand.muted_text_color }};font-weight:600">Qty</th>
          <th align="right" style="padding:0 0 8px;border-bottom:1px solid {{ brand.accent_color }};font-size:12px;color:{{ brand.muted_text_color }};font-weight:600">Amount</th>
        </tr>
      </thead>
      <tbody>
        {% for item in line_items %}
        <tr>
          <td width="44" style="padding:12px 12px 12px 0;border-bottom:1px solid {{ brand.accent_color }};vertical-align:top">
            {% if item.image_url %}
            <img src="{{ item.image_url }}" alt="" width="44" height="44" style="display:block;width:44px;height:44px;border:0;border-radius:6px;object-fit:cover" />
            {% else %}
            <div style="width:44px;height:44px;border-radius:6px;background:{{ brand.accent_color }}"></div>
            {% endif %}
          </td>
          <td style="padding:12px 0;border-bottom:1px solid {{ brand.accent_color }};font-size:14px;color:{{ brand.text_color }};vertical-align:top">
            <div style="margin:0 0 4px;font-weight:600;line-height:19px">{{ item.product_title }}</div>
            <div style="color:{{ brand.muted_text_color }};font-size:12px;line-height:18px">{{ item.variant_title }}{% if item.sku %} · {{ item.sku }}{% endif %}</div>
          </td>
          <td align="center" style="padding:12px 8px;border-bottom:1px solid {{ brand.accent_color }};font-size:14px;color:{{ brand.text_color }};vertical-align:top">{{ item.quantity }}</td>
          <td align="right" style="padding:12px 0;border-bottom:1px solid {{ brand.accent_color }};font-size:14px;color:{{ brand.text_color }};white-space:nowrap;vertical-align:top">{{ item.subtotal_amount }} {{ currency }}</td>
        </tr>
        {% else %}
        <tr>
          <td colspan="4" style="padding:12px 0;color:{{ brand.muted_text_color }};font-size:14px">No item details available.</td>
        </tr>
        {% endfor %}
      </tbody>
    </mj-table>
  </mj-column>
</mj-section>

{% if shipping_address %}
<mj-section background-color="{{ brand.surface_color }}" padding="0 24px 24px">
  <mj-column>
    <mj-divider border-width="1px" border-color="{{ brand.accent_color }}" padding="0 0 16px" />
    <mj-text color="{{ brand.muted_text_color }}" font-size="12px" font-weight="600" padding="0 0 4px">Shipping address</mj-text>
    <mj-text padding="0">
      <strong>{{ shipping_address.full_name }}</strong><br />
      {% for line in shipping_address.lines %}{{ line }}{% if not loop.last %}<br />{% endif %}{% endfor %}
    </mj-text>
  </mj-column>
</mj-section>
{% endif %}

<mj-section background-color="{{ brand.surface_color }}" padding="0 24px 24px">
  <mj-column>
    <mj-table padding="0">
      <tr>
        <td style="padding:8px 0;color:{{ brand.muted_text_color }};font-size:14px">Subtotal</td>
        <td align="right" style="padding:8px 0;color:{{ brand.text_color }};font-size:14px">{{ subtotal_amount }} {{ currency }}</td>
      </tr>
      {% if discount_amount %}
      <tr>
        <td style="padding:8px 0;color:{{ brand.muted_text_color }};font-size:14px">Discount</td>
        <td align="right" style="padding:8px 0;color:{{ brand.text_color }};font-size:14px">-{{ discount_amount }} {{ currency }}</td>
      </tr>
      {% endif %}
      <tr>
        <td style="padding:8px 0;color:{{ brand.muted_text_color }};font-size:14px">Shipping</td>
        <td align="right" style="padding:8px 0;color:{{ brand.text_color }};font-size:14px">{{ shipping_amount }} {{ currency }}</td>
      </tr>
      <tr>
        <td style="padding:8px 0;color:{{ brand.muted_text_color }};font-size:14px">Tax</td>
        <td align="right" style="padding:8px 0;color:{{ brand.text_color }};font-size:14px">{{ tax_amount }} {{ currency }}</td>
      </tr>
      <tr>
        <td style="padding:12px 0 0;border-top:1px solid {{ brand.accent_color }};color:{{ brand.text_color }};font-size:14px;font-weight:700">Total</td>
        <td align="right" style="padding:12px 0 0;border-top:1px solid {{ brand.accent_color }};color:{{ brand.text_color }};font-size:14px;font-weight:700">{{ total_amount }} {{ currency }}</td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>

{% include "components/order-status-button.mjml" %}
{% endblock %}
