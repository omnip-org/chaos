{
    auto_https off
    admin off
}

:8080 {
    encode zstd gzip

    respond /health/gateway 200

    reverse_proxy api-blue:8080 api-green:8080 {
        lb_policy round_robin
        health_uri /health/ready
        health_interval 2s
        health_timeout 1s
        fail_duration 5s
        lb_try_duration 5s
    }
}
