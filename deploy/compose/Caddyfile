{
    admin off
}

:443 {
    tls /etc/caddy/certs/gateway.crt /etc/caddy/certs/gateway.key

    encode zstd gzip

    respond /health/gateway 200

    @internal_metrics path /metrics /metrics/*
    respond @internal_metrics 404

    # Store API is a public, publishable-key-authenticated surface called
    # directly from storefront browsers running on arbitrary merchant
    # domains, so the allowed origin cannot be a fixed list; it is safe to
    # reflect any Origin here because /store/v1/* never relies on cookies
    # and every request must independently carry a valid Bearer key.
    @store_api path /store/v1/*
    header @store_api {
        Access-Control-Allow-Origin "{http.request.header.Origin}"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "authorization, content-type, x-chaos-shopper-token, x-chaos-customer-session"
        Access-Control-Max-Age "600"
        Vary "Origin"
    }

    @store_api_preflight {
        path /store/v1/*
        method OPTIONS
    }
    respond @store_api_preflight 204

    reverse_proxy api-blue:8080 api-green:8080 {
        lb_policy round_robin
        health_uri /health/ready
        health_interval 2s
        health_timeout 1s
        fail_duration 5s
        lb_try_duration 5s
    }
}
