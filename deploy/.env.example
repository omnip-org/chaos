# =============================================================================
# Environment template — used identically for local development and
# production. Copy to `.env` (git-ignored, mode 0600 in production), fill in
# every CHANGE_ME value, and adjust the domain-dependent values noted below.
#
# Generate strong secrets with:  openssl rand -base64 48
# NEVER commit a filled-in copy of this file.
# =============================================================================

# --- Networking (leave as-is; the NGINX gateway maps the public ports) -------
APP_BIND_ADDR=0.0.0.0:8080

# --- Database (REQUIRED) -----------------------------------------------------
# Production: a managed PostgreSQL 17+ with the `pgmq` and `citext` extensions
# enabled (on Supabase, turn on "Queues"/pgmq in the dashboard first). The first
# migration creates the chaos_runtime / chaos_identity roles and grants both to
# the connecting user, so connect as a role allowed to CREATE ROLE / CREATE
# EXTENSION (Supabase's `postgres`).
#
# The connection must be session-scoped, NOT a transaction-mode pooler: every
# connection issues `SET ROLE` and must keep it for the session's lifetime. Use
# a direct connection, or Supabase's session-mode pooler on port 5432 (not the
# transaction pooler on 6543).
DATABASE_URL=postgres://postgres.CHANGE_ME_PROJECT_REF:CHANGE_ME_DB_PASSWORD@CHANGE_ME_REGION.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_IDENTITY_URL defaults to DATABASE_URL; set it only for a separate
# identity database or replica.
# DATABASE_IDENTITY_URL=

DATABASE_RUNTIME_ROLE=chaos_runtime
DATABASE_IDENTITY_ROLE=chaos_identity
# api and worker are separate processes and each opens its own pools, so total
# server connections are roughly 2 * (MAX_CONNECTIONS + IDENTITY_MAX_CONNECTIONS).
# Keep that under the database's connection limit.
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDENTITY_MAX_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_MS=2000

# Local dev only: start the bundled PostgreSQL with the `local` compose profile
#   docker compose -f deploy/docker-compose.yaml --profile local up -d postgres
# and point the app at it (these three are read by that service):
# POSTGRES_DB=chaos
# POSTGRES_USER=chaos
# POSTGRES_PASSWORD=CHANGE_ME_STRONG
# DATABASE_URL=postgres://chaos:CHANGE_ME_STRONG@postgres:5432/chaos

# --- Redis (REQUIRED) --------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- MCP OAuth identity (REQUIRED) ------------------------------------------
# Configure at least one provider client ID. ID tokens are verified against the
# provider's issuer, audience, expiry, verified-email claim, and rotating JWKS.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# APPLE_CLIENT_ID=com.example.chaos
# Comma-separated Host authorities accepted by the public MCP transport.
MCP_ALLOWED_HOSTS=chaos.omnip.org
# Browser origins accepted by the MCP transport. Native MCP clients normally
# omit Origin; keep this list limited to the dashboard/API origins you own.
MCP_ALLOWED_ORIGINS=https://chaos.omnip.org

# --- Payment integrations ----------------------------------------------------
# Stripe API credentials and webhook secrets are configured per Store through
# the Stripe account MCP tools. No sandbox payment provider is built in.
STRIPE_API_BASE_URL=https://api.stripe.com/
# Resend API credentials and sender/webhook settings are configured per Store
# through create_email_account after creating encrypted provider secrets. Email
# brand tokens are configured per Store through configure_email_brand.
RESEND_API_BASE_URL=https://api.resend.com/
ANALYTICS_META_API_BASE_URL=https://graph.facebook.com/v24.0/

# --- Shopper token signing (REQUIRED, >= 32 random bytes) --------------------
SHOPPER_TOKEN_SECRET=CHANGE_ME_openssl_rand_base64_48

# --- Provider secret encryption key (REQUIRED, exactly 32 raw bytes, base64) -
# Encrypts Payment/Shipping/Analytics Provider Key credentials at rest in
# PostgreSQL (AES-256-GCM) and decrypts them at request time. Generate with:
#   openssl rand -base64 32
# Losing this key makes every stored Provider Key permanently unrecoverable
# (there is no rotation/re-encryption tooling) — back it up like you would the
# database itself, and keep it as sensitive as the DB credentials above.
CHAOS_PROVIDER_SECRET_KEY=CHANGE_ME_openssl_rand_base64_32

# --- Optional: media storage (S3-compatible); all five required together -----
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_BUCKET=chaos-media
# MEDIA_S3_ACCESS_KEY_ID=xxx
# MEDIA_S3_SECRET_ACCESS_KEY=xxx
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/
# Required: the externally reachable base URL used in provider setup metadata.
PUBLIC_BASE_URL=https://chaos.omnip.org/
# MEDIA_S3_ENDPOINT_URL=https://s3.example.com   # non-AWS providers
# MEDIA_S3_FORCE_PATH_STYLE=true

# --- Optional: tracing -------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Observability / runtime (safe defaults) ---------------------------------
RUST_LOG=chaos=debug,chaos_api=debug,tower_http=info
LOG_JSON=false
DEPENDENCY_TIMEOUT_MS=1000
SHUTDOWN_DRAIN_DELAY_MS=5000
SHUTDOWN_WORKER_TIMEOUT_MS=30000
