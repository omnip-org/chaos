{
  "openapi": "3.1.0",
  "info": {
    "title": "Chaos Identity API",
    "version": "1.0.0",
    "description": "Identity API for User sessions and trusted-client Access Keys. An Access Key plaintext has the form access_<identifier>_<secret> and is returned only once."
  },
  "servers": [{ "url": "/identity/v1" }],
  "paths": {
    "/auth/external": {
      "post": {
        "operationId": "signInWithExternalIdentity",
        "summary": "Exchange a verified external identity token for a Chaos JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExternalSignIn" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT issued",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccessTokenEnvelope" }
              }
            }
          }
        }
      }
    },
    "/access-keys": {
      "get": {
        "operationId": "listAccessKeys",
        "summary": "List Access Keys owned by the authenticated User",
        "security": [{ "userJwt": [] }],
        "responses": { "200": { "description": "Access Key page" } }
      },
      "post": {
        "operationId": "createAccessKey",
        "summary": "Create a User-owned Access Key",
        "security": [{ "userJwt": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateAccessKey" }
            }
          }
        },
        "responses": { "201": { "description": "Access Key created; secret is returned once" } }
      }
    },
    "/access-keys/{access_key_id}": {
      "delete": {
        "operationId": "revokeAccessKey",
        "summary": "Revoke an Access Key owned by the authenticated User",
        "security": [{ "userJwt": [] }],
        "parameters": [{
          "name": "access_key_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }],
        "responses": { "200": { "description": "Access Key revoked" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userJwt": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "ExternalSignIn": {
        "type": "object",
        "required": ["provider", "identity_token"],
        "properties": {
          "provider": { "type": "string", "enum": ["google", "apple"] },
          "identity_token": { "type": "string", "writeOnly": true }
        }
      },
      "CreateAccessKey": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 80 } }
      },
      "AccessTokenEnvelope": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["user_id", "access_token", "token_type", "expires_in"],
            "properties": {
              "user_id": { "type": "string", "format": "uuid" },
              "access_token": { "type": "string" },
              "token_type": { "type": "string", "const": "Bearer" },
              "expires_in": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
