{
  "openapi": "3.1.0",
  "info": {
    "title": "Chaos Admin API",
    "version": "1.0.0",
    "description": "Passwordless administration API for merchant accounts and headless commerce stores."
  },
  "servers": [
    { "url": "/", "description": "Current origin" }
  ],
  "tags": [
    { "name": "Authentication" },
    { "name": "Merchant accounts" },
    { "name": "Stores" },
    { "name": "Catalog" },
    { "name": "Pricing" },
    { "name": "API keys" }
  ],
  "paths": {
    "/admin/v1/auth/email-links": {
      "post": {
        "operationId": "requestEmailLink",
        "tags": ["Authentication"],
        "summary": "Request a passwordless sign-in link",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RequestEmailLink" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Delivery request accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmptyResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/admin/v1/auth/email-links/verify": {
      "post": {
        "operationId": "verifyEmailLink",
        "tags": ["Authentication"],
        "summary": "Consume a single-use sign-in link",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VerifyEmailLink" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/SessionGranted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/admin/v1/auth/session": {
      "delete": {
        "operationId": "revokeSession",
        "tags": ["Authentication"],
        "summary": "Revoke the current session",
        "security": [{ "bearerSession": [] }],
        "responses": {
          "204": { "description": "Session revoked" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/admin/v1/auth/passkeys/registration/options": {
      "post": {
        "operationId": "startPasskeyRegistration",
        "tags": ["Authentication"],
        "summary": "Start passkey registration",
        "security": [{ "bearerSession": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/PasskeyCeremony" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/admin/v1/auth/passkeys/registration/verify": {
      "post": {
        "operationId": "finishPasskeyRegistration",
        "tags": ["Authentication"],
        "summary": "Verify and persist a passkey",
        "security": [{ "bearerSession": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FinishPasskeyRegistration" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Passkey registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IdentifierResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/admin/v1/auth/passkeys/authentication/options": {
      "post": {
        "operationId": "startPasskeyAuthentication",
        "tags": ["Authentication"],
        "summary": "Start passkey authentication",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RequestEmailLink" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/PasskeyCeremony" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/admin/v1/auth/passkeys/authentication/verify": {
      "post": {
        "operationId": "finishPasskeyAuthentication",
        "tags": ["Authentication"],
        "summary": "Verify a passkey assertion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FinishPasskeyAuthentication" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/SessionGranted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/admin/v1/merchant-accounts": {
      "get": {
        "operationId": "listMerchantAccounts",
        "tags": ["Merchant accounts"],
        "summary": "List merchant accounts for the current user",
        "security": [{ "bearerSession": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Merchant account page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MerchantAccountCollectionEnvelope" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "post": {
        "operationId": "createMerchantAccount",
        "tags": ["Merchant accounts"],
        "summary": "Create a merchant account and owner membership",
        "security": [{ "bearerSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateMerchantAccount" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Merchant account created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IdentifierResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/admin/v1/merchant-accounts/{merchant_account_id}/stores": {
      "parameters": [{ "$ref": "#/components/parameters/MerchantAccountId" }],
      "get": {
        "operationId": "listStores",
        "tags": ["Stores"],
        "summary": "List stores in a merchant account",
        "security": [{ "bearerSession": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Store page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StoreCollectionEnvelope" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      },
      "post": {
        "operationId": "createStore",
        "tags": ["Stores"],
        "summary": "Create a draft store and default currency",
        "security": [{ "bearerSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateStore" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Store created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IdentifierResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/admin/v1/merchant-accounts/{merchant_account_id}/stores/{store_id}/products": {
      "parameters": [
        { "$ref": "#/components/parameters/MerchantAccountId" },
        { "$ref": "#/components/parameters/StoreId" }
      ],
      "get": {
        "operationId": "listProducts",
        "tags": ["Catalog"],
        "summary": "List product summaries in a Store",
        "security": [{ "bearerSession": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Product page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductCollectionEnvelope" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      },
      "post": {
        "operationId": "createProduct",
        "tags": ["Catalog"],
        "summary": "Create a draft product with options and variants",
        "description": "Creates the complete product aggregate atomically. The product remains unpublished until an explicit publication operation succeeds.",
        "security": [{ "bearerSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProduct" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft product created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IdentifierResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/admin/v1/merchant-accounts/{merchant_account_id}/stores/{store_id}/products/{product_id}": {
      "parameters": [
        { "$ref": "#/components/parameters/MerchantAccountId" },
        { "$ref": "#/components/parameters/StoreId" },
        { "$ref": "#/components/parameters/ProductId" }
      ],
      "get": {
        "operationId": "getProduct",
        "tags": ["Catalog"],
        "summary": "Get a complete Product aggregate",
        "security": [{ "bearerSession": [] }],
        "responses": {
          "200": {
            "description": "Product detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductEnvelope" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "updateProduct",
        "tags": ["Catalog"],
        "summary": "Replace Product content",
        "security": [{ "bearerSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProduct" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/ProductMutated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/admin/v1/merchant-accounts/{merchant_account_id}/stores/{store_id}/products/{product_id}/activate": {
      "parameters": [
        { "$ref": "#/components/parameters/MerchantAccountId" },
        { "$ref": "#/components/parameters/StoreId" },
        { "$ref": "#/components/parameters/ProductId" }
      ],
      "post": {
        "operationId": "activateProduct",
        "tags": ["Catalog"],
        "summary": "Activate a Product",
        "security": [{ "bearerSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "200": { "$ref": "#/components/responses/ProductMutated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/admin/v1/merchant-accounts/{merchant_account_id}/stores/{store_id}/products/{product_id}/archive": {
      "parameters": [
        { "$ref": "#/components/parameters/MerchantAccountId" },
        { "$ref": "#/components/parameters/StoreId" },
        { "$ref": "#/components/parameters/ProductId" }
      ],
      "post": {
        "operationId": "archiveProduct",
        "tags": ["Catalog"],
        "summary": "Archive a Product",
        "security": [{ "bearerSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "200": { "$ref": "#/components/responses/ProductMutated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/admin/v1/merchant-accounts/{merchant_account_id}/stores/{store_id}/products/{product_id}/publications/{sales_channel_id}": {
      "parameters": [
        { "$ref": "#/components/parameters/MerchantAccountId" },
        { "$ref": "#/components/parameters/StoreId" },
        { "$ref": "#/components/parameters/ProductId" },
        { "$ref": "#/components/parameters/SalesChannelId" },
        { "$ref": "#/components/parameters/IdempotencyKey" }
      ],
      "put": {
        "operationId": "publishProduct",
        "tags": ["Catalog"],
        "summary": "Publish a Product to a Sales Channel",
        "security": [{ "bearerSession": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/ProductMutated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      },
      "delete": {
        "operationId": "unpublishProduct",
        "tags": ["Catalog"],
        "summary": "Remove Product publication from a Sales Channel",
        "security": [{ "bearerSession": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/ProductMutated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/admin/v1/merchant-accounts/{merchant_account_id}/stores/{store_id}/price-lists": {
      "parameters": [
        { "$ref": "#/components/parameters/MerchantAccountId" },
        { "$ref": "#/components/parameters/StoreId" }
      ],
      "post": {
        "operationId": "createPriceList",
        "tags": ["Pricing"],
        "summary": "Create a currency-specific Price List",
        "description": "Creates a Price List and its Variant prices atomically. An active list may reference only active Variants in the same Store.",
        "security": [{ "bearerSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePriceList" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Price List created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IdentifierResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/admin/v1/merchant-accounts/{merchant_account_id}/stores/{store_id}/api-keys": {
      "parameters": [
        { "$ref": "#/components/parameters/MerchantAccountId" },
        { "$ref": "#/components/parameters/StoreId" }
      ],
      "get": {
        "operationId": "listApiKeys",
        "tags": ["API keys"],
        "summary": "List Store API keys without secret material",
        "security": [{ "bearerSession": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "API key page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiKeyCollectionEnvelope" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      },
      "post": {
        "operationId": "createApiKey",
        "tags": ["API keys"],
        "summary": "Create a Store-scoped API key",
        "description": "The plaintext secret is returned exactly once. Replaying the Idempotency-Key returns a conflict instead of disclosing it again.",
        "security": [{ "bearerSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateApiKey" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "API key created; copy the one-time secret now",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiKeyCreatedEnvelope" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/admin/v1/merchant-accounts/{merchant_account_id}/stores/{store_id}/api-keys/{api_key_id}": {
      "parameters": [
        { "$ref": "#/components/parameters/MerchantAccountId" },
        { "$ref": "#/components/parameters/StoreId" },
        { "$ref": "#/components/parameters/ApiKeyId" }
      ],
      "delete": {
        "operationId": "revokeApiKey",
        "tags": ["API keys"],
        "summary": "Revoke an API key",
        "security": [{ "bearerSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "204": { "description": "API key revoked" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque revocable session token"
      }
    },
    "parameters": {
      "MerchantAccountId": {
        "name": "merchant_account_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "StoreId": {
        "name": "store_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "ProductId": {
        "name": "product_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "SalesChannelId": {
        "name": "sales_channel_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "ApiKeyId": {
        "name": "api_key_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Opaque cursor returned by the previous page.",
        "schema": { "type": "string" }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed JSON, query, content type, or payload size",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "Unauthorized": {
        "description": "Authentication required or credential invalid",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "Forbidden": {
        "description": "Authenticated caller is not allowed to access the resource",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "NotFound": {
        "description": "The resource does not exist in the authorized scope",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "Conflict": {
        "description": "Idempotency or unique-domain conflict",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "ValidationFailed": {
        "description": "Domain or request validation failed",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "ServiceUnavailable": {
        "description": "Required dependency unavailable",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "SessionGranted": {
        "description": "Session created",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionResponse" } } }
      },
      "PasskeyCeremony": {
        "description": "WebAuthn ceremony options created",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasskeyCeremonyResponse" } } }
      },
      "ProductMutated": {
        "description": "Product mutation completed",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IdentifierResponse" } } }
      }
    },
    "schemas": {
      "RequestEmailLink": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email"],
        "properties": { "email": { "type": "string", "format": "email", "maxLength": 320 } }
      },
      "VerifyEmailLink": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token"],
        "properties": { "token": { "type": "string" } }
      },
      "FinishPasskeyRegistration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ceremony_id", "name", "credential"],
        "properties": {
          "ceremony_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "credential": { "type": "object", "additionalProperties": true }
        }
      },
      "FinishPasskeyAuthentication": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ceremony_id", "credential"],
        "properties": {
          "ceremony_id": { "type": "string", "format": "uuid" },
          "credential": { "type": "object", "additionalProperties": true }
        }
      },
      "CreateMerchantAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "display_name"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$" },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      },
      "CreateStore": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,30}[a-z0-9]$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "default_region": { "$ref": "#/components/schemas/RegionCode" },
          "default_currency": { "$ref": "#/components/schemas/CurrencyCode" }
        }
      },
      "CreateProductSelectedOption": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option", "value"],
        "properties": {
          "option": { "type": "string", "minLength": 1, "maxLength": 80 },
          "value": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      },
      "CreateProductVariant": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 255 },
          "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
          "requires_shipping": { "type": "boolean", "default": true },
          "track_inventory": { "type": "boolean", "default": true },
          "selected_options": {
            "type": "array",
            "default": [],
            "maxItems": 10,
            "items": { "$ref": "#/components/schemas/CreateProductSelectedOption" }
          }
        }
      },
      "CreateProductOption": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "values"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "values": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        }
      },
      "CreateProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "title"],
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,126}[a-z0-9]$"
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 255 },
          "description": { "type": "string", "maxLength": 100000, "default": "" },
          "options": {
            "type": "array",
            "default": [],
            "maxItems": 10,
            "items": { "$ref": "#/components/schemas/CreateProductOption" }
          },
          "variants": {
            "type": "array",
            "default": [],
            "items": { "$ref": "#/components/schemas/CreateProductVariant" }
          }
        }
      },
      "UpdateProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "title"],
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,126}[a-z0-9]$"
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 255 },
          "description": { "type": "string", "maxLength": 100000, "default": "" }
        }
      },
      "ProductStatus": {
        "type": "string",
        "enum": ["draft", "active", "archived"]
      },
      "VariantStatus": {
        "type": "string",
        "enum": ["active", "archived"]
      },
      "ProductSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "handle",
          "title",
          "status",
          "variant_count",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "handle": { "type": "string" },
          "title": { "type": "string" },
          "status": { "$ref": "#/components/schemas/ProductStatus" },
          "variant_count": { "type": "integer", "minimum": 0 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ProductOptionValue": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "position"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "value": { "type": "string" },
          "position": { "type": "integer", "minimum": 0 }
        }
      },
      "ProductOption": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "position", "values"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "position": { "type": "integer", "minimum": 0 },
          "values": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProductOptionValue" }
          }
        }
      },
      "SelectedOption": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "option_name", "option_value_id", "value"],
        "properties": {
          "option_id": { "type": "string", "format": "uuid" },
          "option_name": { "type": "string" },
          "option_value_id": { "type": "string", "format": "uuid" },
          "value": { "type": "string" }
        }
      },
      "ProductVariant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "requires_shipping",
          "track_inventory",
          "selected_options",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "sku": { "type": "string" },
          "status": { "$ref": "#/components/schemas/VariantStatus" },
          "requires_shipping": { "type": "boolean" },
          "track_inventory": { "type": "boolean" },
          "selected_options": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SelectedOption" }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "handle",
          "title",
          "description",
          "status",
          "options",
          "variants",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "handle": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": { "$ref": "#/components/schemas/ProductStatus" },
          "options": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProductOption" }
          },
          "variants": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProductVariant" }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ProductEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/Product" } }
      },
      "CreatePrice": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_variant_id", "amount_minor"],
        "properties": {
          "product_variant_id": { "type": "string", "format": "uuid" },
          "amount_minor": { "type": "integer", "format": "int64", "minimum": 0 }
        }
      },
      "CreatePriceList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "currency"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$"
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "currency": { "$ref": "#/components/schemas/CurrencyCode" },
          "tax_inclusive": { "type": "boolean", "default": false },
          "starts_at": { "type": "string", "format": "date-time" },
          "ends_at": { "type": "string", "format": "date-time" },
          "activate": { "type": "boolean", "default": false },
          "prices": {
            "type": "array",
            "default": [],
            "items": { "$ref": "#/components/schemas/CreatePrice" }
          }
        }
      },
      "ApiKeyClass": { "type": "string", "enum": ["publishable", "secret"] },
      "ApiKeyMode": { "type": "string", "enum": ["test", "live"] },
      "ApiKeyScope": {
        "type": "string",
        "enum": [
          "catalog:read",
          "carts:write",
          "checkout:write",
          "orders:read",
          "customers:write",
          "mcp:tools"
        ]
      },
      "CreateApiKey": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "class", "mode", "scopes"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "class": { "$ref": "#/components/schemas/ApiKeyClass" },
          "mode": { "$ref": "#/components/schemas/ApiKeyMode" },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/components/schemas/ApiKeyScope" }
          }
        }
      },
      "ApiKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "key_identifier",
          "display_suffix",
          "class",
          "mode",
          "scopes",
          "created_at"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "key_identifier": { "type": "string", "minLength": 16, "maxLength": 16 },
          "display_suffix": { "type": "string", "minLength": 4, "maxLength": 4 },
          "class": { "$ref": "#/components/schemas/ApiKeyClass" },
          "mode": { "$ref": "#/components/schemas/ApiKeyMode" },
          "scopes": { "type": "array", "items": { "$ref": "#/components/schemas/ApiKeyScope" } },
          "created_at": { "type": "string", "format": "date-time" },
          "revoked_at": { "type": "string", "format": "date-time" }
        }
      },
      "ApiKeyCreated": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "key_identifier",
          "display_suffix",
          "class",
          "mode",
          "scopes",
          "secret"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "key_identifier": { "type": "string", "minLength": 16, "maxLength": 16 },
          "display_suffix": { "type": "string", "minLength": 4, "maxLength": 4 },
          "class": { "$ref": "#/components/schemas/ApiKeyClass" },
          "mode": { "$ref": "#/components/schemas/ApiKeyMode" },
          "scopes": { "type": "array", "items": { "$ref": "#/components/schemas/ApiKeyScope" } },
          "secret": {
            "type": "string",
            "format": "password",
            "readOnly": true,
            "x-sensitive": true,
            "description": "One-time plaintext API key. It cannot be retrieved again."
          }
        }
      },
      "ApiKeyCreatedEnvelope": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/ApiKeyCreated" } }
      },
      "RegionCode": { "type": "string", "pattern": "^[A-Z]{2}$", "default": "US" },
      "CurrencyCode": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "USD" },
      "Identifier": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": { "id": { "type": "string", "format": "uuid" } }
      },
      "IdentifierResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/Identifier" } }
      },
      "EmptyResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "type": "object", "additionalProperties": false } }
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_token", "token_type", "expires_in"],
        "properties": {
          "session_token": { "type": "string" },
          "token_type": { "type": "string", "const": "Bearer" },
          "expires_in": { "type": "integer", "minimum": 1 }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/Session" } }
      },
      "PasskeyCeremony": {
        "type": "object",
        "required": ["ceremony_id", "public_key"],
        "properties": {
          "ceremony_id": { "type": "string", "format": "uuid" },
          "public_key": { "type": "object", "additionalProperties": true }
        }
      },
      "PasskeyCeremonyResponse": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/PasskeyCeremony" } }
      },
      "MerchantAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slug", "display_name", "status", "role"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string" },
          "display_name": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "suspended", "closed"] },
          "role": { "type": "string", "enum": ["owner", "administrator", "developer", "manager", "support"] }
        }
      },
      "Store": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "code", "name", "default_region", "default_currency", "status"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "default_region": { "$ref": "#/components/schemas/RegionCode" },
          "default_currency": { "$ref": "#/components/schemas/CurrencyCode" },
          "status": { "type": "string", "enum": ["draft", "active", "archived"] }
        }
      },
      "PageMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": ["has_more"],
        "properties": {
          "has_more": { "type": "boolean" },
          "next_cursor": { "type": "string" }
        }
      },
      "ResponseMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page"],
        "properties": { "page": { "$ref": "#/components/schemas/PageMeta" } }
      },
      "MerchantAccountCollectionEnvelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/MerchantAccount" } },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "StoreCollectionEnvelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Store" } },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "ProductCollectionEnvelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/ProductSummary" } },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "ApiKeyCollectionEnvelope": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/ApiKey" } },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string" },
          "reason": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "array", "items": { "$ref": "#/components/schemas/ErrorDetail" } }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": { "error": { "$ref": "#/components/schemas/Error" } }
      }
    }
  }
}
