{
  "openapi": "3.1.0",
  "info": {
    "title": "Chaos Provider Webhooks API",
    "version": "1.0.0",
    "description": "Provider callbacks authenticated before Store resolution and durably deduplicated."
  },
  "servers": [{ "url": "/webhooks/v1" }],
  "paths": {
    "/payments/{provider}": {
      "post": {
        "operationId": "receivePaymentWebhook",
        "tags": ["Payment webhooks"],
        "summary": "Verify and enqueue a payment provider event",
        "security": [{ "paymentSignature": [] }, { "stripeSignature": [] }],
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "oneOf": [
            { "$ref": "#/components/schemas/PaymentWebhookEvent" },
            { "$ref": "#/components/schemas/StripeWebhookEvent" }
          ] } } }
        },
        "responses": {
          "202": {
            "description": "Verified event accepted or recognized as a duplicate",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookReceiptEnvelope" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/notifications/{provider}": {
      "post": {
        "operationId": "receiveNotificationWebhook",
        "tags": ["Notification webhooks"],
        "summary": "Verify and reconcile a notification provider event",
        "security": [{ "svixSignature": [] }],
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["resend"] }
          },
          { "$ref": "#/components/parameters/SvixId" },
          { "$ref": "#/components/parameters/SvixTimestamp" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResendWebhookEvent" } } }
        },
        "responses": {
          "202": {
            "description": "Verified event reconciled or recognized as a duplicate or unknown delivery",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookReceiptEnvelope" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "description": "Payload exceeds 64 KiB" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "paymentSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-payment-signature",
        "description": "Base64-encoded HMAC-SHA256 of the exact request body."
      },
      "stripeSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "Stripe-Signature",
        "description": "Stripe timestamped v1 signature over the exact request body."
      },
      "svixSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "svix-signature",
        "description": "Svix v1 signature over svix-id, svix-timestamp, and the exact request body."
      }
    },
    "parameters": {
      "SvixId": {
        "name": "svix-id",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "SvixTimestamp": {
        "name": "svix-timestamp",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "pattern": "^[0-9]{1,20}$" }
      }
    },
    "schemas": {
      "PaymentWebhookEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "event_type", "account", "object", "aggregate_id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "event_type": {
            "type": "string",
            "enum": ["payment.authorized", "payment.captured", "payment.failed", "payment.cancelled", "refund.succeeded", "refund.failed"]
          },
          "account": { "type": "string", "minLength": 1, "maxLength": 255 },
          "object": { "type": "string", "minLength": 1, "maxLength": 255 },
          "aggregate_id": { "type": "string", "format": "uuid" },
          "failure_code": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      },
      "StripeWebhookEvent": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type", "data"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "data": { "type": "object" }
        }
      },
      "ResendWebhookEvent": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type", "data"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["email.sent", "email.delivered", "email.delivery_delayed", "email.bounced", "email.complained", "email.suppressed"]
          },
          "data": {
            "type": "object",
            "required": ["email_id"],
            "properties": { "email_id": { "type": "string", "minLength": 1, "maxLength": 255 } }
          }
        }
      },
      "WebhookReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted"],
        "properties": { "accepted": { "type": "boolean" } }
      },
      "WebhookReceiptEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/WebhookReceipt" } }
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": { "field": { "type": "string" }, "reason": { "type": "string" } }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "array", "items": { "$ref": "#/components/schemas/ErrorDetail" } }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": { "error": { "$ref": "#/components/schemas/Error" } }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid provider signature",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "NotFound": {
        "description": "Provider or enabled Provider Account not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "ValidationFailed": {
        "description": "Invalid verified event payload",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    }
  }
}
