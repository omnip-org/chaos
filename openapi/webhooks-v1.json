{
  "openapi": "3.1.0",
  "info": {
    "title": "Chaos Provider Webhooks API",
    "version": "1.0.0",
    "description": "Stripe Checkout callbacks authenticated before Store resolution and durably deduplicated. The provider_account_id is the Chaos Provider Account UUID, not a Stripe acct_ identifier."
  },
  "servers": [{ "url": "/webhooks/v1" }],
  "paths": {
    "/payments/{provider}/{provider_account_id}": {
      "post": {
        "operationId": "receivePaymentWebhook",
        "tags": ["Payment webhooks"],
        "summary": "Verify and enqueue a Stripe Checkout event",
        "security": [{ "stripeSignature": [] }],
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "description": "The configured payment provider. Only stripe_checkout is supported.",
            "schema": { "type": "string", "enum": ["stripe_checkout"] }
          },
          {
            "name": "provider_account_id",
            "in": "path",
            "required": true,
            "description": "The Chaos Provider Account UUID returned when the Store configures stripe_checkout. This is not a Stripe account ID.",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StripeWebhookEvent" } } }
        },
        "responses": {
          "202": {
            "description": "Verified event accepted or recognized as a duplicate",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookReceiptEnvelope" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "stripeSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "Stripe-Signature",
        "description": "Stripe timestamped v1 signature over the exact request body."
      }
    },
    "schemas": {
      "StripeWebhookEvent": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type", "data"],
        "properties": {
          "id": { "type": "string", "pattern": "^evt_[A-Za-z0-9_]+$", "maxLength": 255 },
          "type": {
            "type": "string",
            "enum": [
              "checkout.session.completed",
              "checkout.session.async_payment_succeeded",
              "checkout.session.async_payment_failed",
              "checkout.session.expired"
            ]
          },
          "data": {
            "type": "object",
            "required": ["object"],
            "properties": {
              "object": {
                "type": "object",
                "required": ["id", "metadata"],
                "properties": {
                  "id": { "type": "string", "pattern": "^cs_[A-Za-z0-9_]+$", "maxLength": 255 },
                  "payment_status": { "type": "string", "enum": ["paid", "no_payment_required"] },
                  "metadata": {
                    "type": "object",
                    "required": ["chaos_payment_attempt_id"],
                    "properties": {
                      "chaos_payment_attempt_id": { "type": "string", "format": "uuid" }
                    },
                    "additionalProperties": { "type": "string" }
                  },
                  "last_payment_error": { "type": "object", "additionalProperties": true },
                  "failure_reason": { "type": "string", "maxLength": 255 }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "WebhookReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted"],
        "properties": { "accepted": { "type": "boolean" } }
      },
      "WebhookReceiptEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/WebhookReceipt" } }
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": { "field": { "type": "string" }, "reason": { "type": "string" } }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "array", "items": { "$ref": "#/components/schemas/ErrorDetail" } }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": { "error": { "$ref": "#/components/schemas/Error" } }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid provider signature",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "NotFound": {
        "description": "Provider or enabled Provider Account not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "ValidationFailed": {
        "description": "Invalid verified event payload",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    }
  }
}
