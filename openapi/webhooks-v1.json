{
  "openapi": "3.1.0",
  "info": {
    "title": "Chaos Stripe Webhooks API",
    "version": "1.0.0",
    "description": "Stripe callbacks authenticated before Store resolution and durably deduplicated. The store_id identifies the Chaos Store; the Stripe signing secret authenticates the request."
  },
  "servers": [{ "url": "/storefront/v1" }],
  "paths": {
    "/webhooks/stripe/{store_id}": {
      "post": {
        "operationId": "receivePaymentWebhook",
        "tags": ["Payment webhooks"],
        "summary": "Verify and enqueue a Stripe Checkout event",
        "security": [{ "stripeSignature": [] }],
        "parameters": [
          {
            "name": "store_id",
            "in": "path",
            "required": true,
            "description": "The Chaos Store UUID whose single Stripe account should verify this webhook.",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StripeWebhookEvent" } } }
        },
        "responses": {
          "202": {
            "description": "Verified event accepted or recognized as a duplicate",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookReceiptEnvelope" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "stripeSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "Stripe-Signature",
        "description": "Stripe timestamped v1 signature over the exact request body."
      }
    },
    "schemas": {
      "StripeWebhookEvent": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type", "data"],
        "properties": {
          "id": { "type": "string", "pattern": "^evt_[A-Za-z0-9_]+$", "maxLength": 255 },
          "type": {
            "type": "string",
            "enum": [
              "checkout.session.completed",
              "checkout.session.async_payment_succeeded",
              "checkout.session.async_payment_failed",
              "checkout.session.expired",
              "refund.created",
              "refund.updated"
            ]
          },
          "data": {
            "type": "object",
            "required": ["object"],
            "properties": {
              "object": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "type": "string", "pattern": "^(cs_|re_)[A-Za-z0-9_]+$", "maxLength": 255 },
                  "payment_status": { "type": "string", "enum": ["paid", "no_payment_required", "unpaid"] },
                  "payment_intent": { "type": "string", "pattern": "^pi_[A-Za-z0-9_]+$" },
                  "metadata": {
                    "type": "object",
                    "properties": {
                      "chaos_order_id": { "type": "string", "format": "uuid", "description": "Required for checkout.session.* events; present on refunds created by Chaos." }
                    },
                    "additionalProperties": { "type": "string" }
                  },
                  "status": { "type": "string", "enum": ["pending", "succeeded", "failed", "canceled"] },
                  "last_payment_error": { "type": "object", "additionalProperties": true },
                  "failure_reason": { "type": "string", "maxLength": 255 }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "WebhookReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted"],
        "properties": { "accepted": { "type": "boolean" } }
      },
      "WebhookReceiptEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/WebhookReceipt" } }
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": { "field": { "type": "string" }, "reason": { "type": "string" } }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "array", "items": { "$ref": "#/components/schemas/ErrorDetail" } }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": { "error": { "$ref": "#/components/schemas/Error" } }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid Stripe signature",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "NotFound": {
        "description": "Store or enabled Stripe account configuration not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "ValidationFailed": {
        "description": "Invalid verified event payload",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    }
  }
}
