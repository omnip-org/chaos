{
  "openapi": "3.1.0",
  "info": {
    "title": "Chaos Commerce Store API",
    "version": "1.0.0",
    "description": "Public Storefront API authenticated by Store-scoped publishable keys."
  },
  "servers": [{ "url": "/store/v1" }],
  "paths": {
    "/products": {
      "get": {
        "operationId": "listStorefrontProducts",
        "tags": ["Catalog"],
        "summary": "List active and published Products with active prices",
        "security": [{ "publishableKey": ["catalog:read"] }],
        "parameters": [
          { "$ref": "#/components/parameters/Currency" },
          { "name": "q", "in": "query", "description": "Store-isolated full-text search", "schema": { "type": "string", "minLength": 1, "maxLength": 200 } },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Storefront Product page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductCollectionEnvelope" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/products/{handle}": {
      "get": {
        "operationId": "getStorefrontProduct",
        "tags": ["Catalog"],
        "summary": "Get one active and published Product by handle",
        "security": [{ "publishableKey": ["catalog:read"] }],
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 2, "maxLength": 128 }
          },
          { "$ref": "#/components/parameters/Currency" }
        ],
        "responses": {
          "200": {
            "description": "Storefront Product",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductEnvelope" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/carts": {
      "post": {
        "operationId": "createCart",
        "tags": ["Carts"],
        "summary": "Create an active Cart using the current Price List",
        "security": [{ "publishableKey": ["carts:write"] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCart" } } }
        },
        "responses": {
          "201": { "description": "Cart created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CartEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/carts/{cart_id}": {
      "get": {
        "operationId": "getCart",
        "tags": ["Carts"],
        "summary": "Get a Cart",
        "security": [{ "publishableKey": ["carts:write"] }],
        "parameters": [{ "$ref": "#/components/parameters/CartId" }],
        "responses": {
          "200": { "description": "Cart", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CartEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/carts/{cart_id}/lines/{product_variant_id}": {
      "put": {
        "operationId": "setCartLine",
        "tags": ["Carts"],
        "summary": "Add a Cart line or replace its quantity and current snapshot",
        "security": [{ "publishableKey": ["carts:write"] }],
        "parameters": [
          { "$ref": "#/components/parameters/CartId" },
          { "$ref": "#/components/parameters/ProductVariantId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetCartLine" } } } },
        "responses": {
          "200": { "description": "Updated Cart", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CartEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      },
      "delete": {
        "operationId": "removeCartLine",
        "tags": ["Carts"],
        "summary": "Remove a Cart line",
        "security": [{ "publishableKey": ["carts:write"] }],
        "parameters": [
          { "$ref": "#/components/parameters/CartId" },
          { "$ref": "#/components/parameters/ProductVariantId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "description": "Updated Cart", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CartEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/carts/{cart_id}/checkout": {
      "post": {
        "operationId": "createCheckout",
        "tags": ["Checkout"],
        "summary": "Freeze Cart prices and reserve tracked inventory atomically",
        "security": [{ "publishableKey": ["checkout:write"] }],
        "parameters": [
          { "$ref": "#/components/parameters/CartId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "201": { "description": "Checkout created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/checkouts/{checkout_id}": {
      "get": {
        "operationId": "getCheckout",
        "tags": ["Checkout"],
        "summary": "Get an immutable Checkout snapshot",
        "security": [{ "publishableKey": ["checkout:write"] }],
        "parameters": [{ "$ref": "#/components/parameters/CheckoutId" }],
        "responses": {
          "200": { "description": "Checkout", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/checkouts/{checkout_id}/order": {
      "post": {
        "operationId": "createOrder",
        "tags": ["Orders"],
        "summary": "Create an Order from an immutable Checkout snapshot",
        "security": [{ "publishableKey": ["checkout:write"] }],
        "parameters": [
          { "$ref": "#/components/parameters/CheckoutId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "201": { "description": "Order created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "operationId": "getOrder",
        "tags": ["Orders"],
        "summary": "Get an Order and its transition audit trail",
        "security": [{ "publishableKey": ["checkout:write"] }],
        "parameters": [{ "$ref": "#/components/parameters/OrderId" }],
        "responses": {
          "200": { "description": "Order", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/orders/{order_id}/payment-attempts": {
      "post": {
        "operationId": "createPaymentAttempt",
        "tags": ["Payments"],
        "summary": "Create a Payment Attempt and enqueue a provider command atomically",
        "security": [{ "publishableKey": ["checkout:write"] }],
        "parameters": [
          { "$ref": "#/components/parameters/OrderId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePaymentAttempt" } } } },
        "responses": {
          "201": { "description": "Payment Attempt created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentAttemptEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/payment-attempts/{payment_attempt_id}": {
      "get": {
        "operationId": "getPaymentAttempt",
        "tags": ["Payments"],
        "summary": "Get a Payment Attempt visible to this Store and Sales Channel",
        "security": [{ "publishableKey": ["checkout:write"] }],
        "parameters": [{ "$ref": "#/components/parameters/PaymentAttemptId" }],
        "responses": {
          "200": { "description": "Payment Attempt", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentAttemptEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "publishableKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Store-scoped publishable key with the scope declared by the operation."
      }
    },
    "parameters": {
      "Currency": {
        "name": "currency",
        "in": "query",
        "required": false,
        "description": "Enabled Store currency. Defaults to the Store default currency.",
        "schema": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": { "type": "string" }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "CartId": {
        "name": "cart_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "ProductVariantId": {
        "name": "product_variant_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "CheckoutId": {
        "name": "checkout_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "OrderId": {
        "name": "order_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "PaymentAttemptId": {
        "name": "payment_attempt_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "schemas": {
      "Price": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount_minor", "currency", "tax_inclusive"],
        "properties": {
          "amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "tax_inclusive": { "type": "boolean" }
        }
      },
      "ProductVariant": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "requires_shipping", "price"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "sku": { "type": "string" },
          "requires_shipping": { "type": "boolean" },
          "price": { "$ref": "#/components/schemas/Price" }
        }
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "handle", "title", "description", "variants"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "handle": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/ProductVariant" }
          }
        }
      },
      "CreateCart": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
        }
      },
      "SetCartLine": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quantity"],
        "properties": {
          "quantity": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 999 }
        }
      },
      "CartLine": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "product_variant_id", "product_title", "variant_title", "requires_shipping", "track_inventory", "quantity", "unit_price_amount_minor", "subtotal_amount_minor", "tax_inclusive"],
        "properties": {
          "product_id": { "type": "string", "format": "uuid" },
          "product_variant_id": { "type": "string", "format": "uuid" },
          "product_title": { "type": "string" },
          "variant_title": { "type": "string" },
          "sku": { "type": "string" },
          "requires_shipping": { "type": "boolean" },
          "track_inventory": { "type": "boolean" },
          "quantity": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 999 },
          "unit_price_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "subtotal_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "tax_inclusive": { "type": "boolean" }
        }
      },
      "Cart": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "price_list_id", "currency", "status", "version", "lines", "subtotal_amount_minor", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "price_list_id": { "type": "string", "format": "uuid" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "status": { "type": "string", "enum": ["active", "completed", "abandoned"] },
          "version": { "type": "integer", "format": "int64", "minimum": 1 },
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/CartLine" } },
          "subtotal_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CheckoutLine": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "product_variant_id", "product_title", "variant_title", "requires_shipping", "quantity", "unit_price_amount_minor", "subtotal_amount_minor", "discount_amount_minor", "tax_amount_minor", "total_amount_minor", "tax_inclusive"],
        "properties": {
          "product_id": { "type": "string", "format": "uuid" },
          "product_variant_id": { "type": "string", "format": "uuid" },
          "product_title": { "type": "string" },
          "variant_title": { "type": "string" },
          "sku": { "type": "string" },
          "requires_shipping": { "type": "boolean" },
          "track_inventory": { "type": "boolean" },
          "quantity": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 999 },
          "unit_price_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "subtotal_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "discount_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "tax_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "total_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "tax_inclusive": { "type": "boolean" }
        }
      },
      "Checkout": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cart_id", "price_list_id", "currency", "status", "subtotal_amount_minor", "discount_amount_minor", "tax_amount_minor", "total_amount_minor", "expires_at", "lines", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "cart_id": { "type": "string", "format": "uuid" },
          "inventory_reservation_id": { "type": "string", "format": "uuid" },
          "price_list_id": { "type": "string", "format": "uuid" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "status": { "type": "string", "enum": ["pending"] },
          "subtotal_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "discount_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "tax_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "total_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "expires_at": { "type": "string", "format": "date-time" },
          "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/CheckoutLine" } },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "CartEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/Cart" } }
      },
      "CheckoutEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/Checkout" } }
      },
      "OrderLine": {
        "allOf": [
          { "$ref": "#/components/schemas/CheckoutLine" },
          {
            "type": "object",
            "required": ["track_inventory"],
            "properties": { "track_inventory": { "type": "boolean" } }
          }
        ]
      },
      "OrderTransition": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "to_status", "kind", "occurred_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "from_status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
          "to_status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
          "kind": { "type": "string", "enum": ["created", "confirmed", "cancelled"] },
          "occurred_at": { "type": "string", "format": "date-time" }
        }
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "checkout_id", "price_list_id", "currency", "status", "subtotal_amount_minor", "discount_amount_minor", "tax_amount_minor", "total_amount_minor", "lines", "transitions", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "checkout_id": { "type": "string", "format": "uuid" },
          "inventory_reservation_id": { "type": "string", "format": "uuid" },
          "price_list_id": { "type": "string", "format": "uuid" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
          "subtotal_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "discount_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "tax_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "total_amount_minor": { "type": "integer", "format": "int64", "minimum": 0 },
          "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/OrderLine" } },
          "transitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/OrderTransition" } },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "OrderEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/Order" } }
      },
      "CreatePaymentAttempt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider"],
        "properties": { "provider": { "type": "string", "minLength": 1, "maxLength": 64 } }
      },
      "PaymentAttempt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order_id", "provider", "amount_minor", "currency", "status", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "order_id": { "type": "string", "format": "uuid" },
          "provider": { "type": "string" },
          "amount_minor": { "type": "integer", "format": "int64", "minimum": 1 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "status": { "type": "string", "enum": ["pending", "authorized", "captured", "failed", "cancelled"] },
          "provider_reference": { "type": "string" },
          "failure_code": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "PaymentAttemptEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/PaymentAttempt" } }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": ["has_more"],
        "properties": {
          "has_more": { "type": "boolean" },
          "next_cursor": { "type": "string" }
        }
      },
      "Meta": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page"],
        "properties": { "page": { "$ref": "#/components/schemas/Page" } }
      },
      "ProductEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/Product" } }
      },
      "ProductCollectionEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Product" }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string" },
          "reason": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "array", "items": { "$ref": "#/components/schemas/ErrorDetail" } }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": { "error": { "$ref": "#/components/schemas/Error" } }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid publishable key",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "Forbidden": {
        "description": "Credential class or scope is not allowed",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "NotFound": {
        "description": "Resource not found or not visible to this Store credential",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "BadRequest": {
        "description": "Malformed request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "Conflict": {
        "description": "Idempotency conflict, terminal Cart, stale price, or insufficient inventory",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "ValidationFailed": {
        "description": "Invalid header, body, query, or path value",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    }
  }
}
