{
  "name": "@omnip-org/chaos-js",
  "version": "0.1.0",
  "description": "Typed client and first-party analytics for Chaos Commerce storefronts, built on the public-key-authenticated Storefront API.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stripe": {
      "types": "./dist/stripe.d.ts",
      "default": "./dist/stripe.js"
    }
  },
  "files": ["dist", "!dist/test", "README.md"],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test dist/**/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.14.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "Apache-2.0"
}
