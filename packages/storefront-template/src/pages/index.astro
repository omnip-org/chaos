---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { createChaosClient } from "../lib/chaos";
import type { Product } from "@omnip-org/chaos-js";

let products: Product[] = [];
let loadError: string | null = null;
try {
  const chaos = createChaosClient();
  ({ data: products } = await chaos.catalog.listProducts());
} catch {
  loadError =
    "Could not reach the Store API. Check PUBLIC_CHAOS_STORE_API_BASE_URL and PUBLIC_CHAOS_PUBLISHABLE_KEY in your .env file, and confirm the backend is running.";
}
---

<BaseLayout title="Storefront">
  <h1 class="text-2xl font-semibold">Products</h1>
  {loadError && <p class="mt-6 rounded-md bg-red-50 p-4 text-sm text-red-700">{loadError}</p>}
  {
    !loadError && (
      <div class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    )
  }
  {!loadError && products.length === 0 && <p class="mt-6 text-gray-500">No products yet.</p>}
</BaseLayout>
