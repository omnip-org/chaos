---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrderStatus from "../../components/react/OrderStatus";

const orderId = Astro.url.searchParams.get("order_id");
---

<BaseLayout title="Payment status">
  <div class="mx-auto max-w-md text-center">
    <h1 class="text-2xl font-semibold">Thank you for your order</h1>
    {orderId
      ? <OrderStatus client:load orderId={orderId} />
      : <p class="mt-4 text-red-600">The return URL did not contain an order ID.</p>}
    <a href="/" class="mt-8 inline-block rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">
      Continue shopping
    </a>
  </div>
</BaseLayout>
