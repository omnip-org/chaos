---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Checkout cancelled">
  <div class="mx-auto max-w-md text-center">
    <h1 class="text-2xl font-semibold">Checkout cancelled</h1>
    <p class="mt-4 text-gray-600">Your payment was not completed. Your cart is still saved.</p>
    <a href="/cart" class="mt-8 inline-block rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">
      Return to cart
    </a>
  </div>
</BaseLayout>
