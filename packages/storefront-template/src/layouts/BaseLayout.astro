---
import Header from "../components/Header.astro";
import "../styles/global.css";

interface Props {
  title: string;
  analyticsProductId?: string;
  privatePage?: boolean;
}

const { title, analyticsProductId, privatePage = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {privatePage && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {privatePage && <meta name="referrer" content="no-referrer" />}
  </head>
  <body class="min-h-screen bg-white text-gray-900" data-analytics-product-id={analyticsProductId}>
    <Header />
    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
    <aside id="analytics-consent" class="fixed inset-x-4 bottom-4 hidden rounded-md border bg-white p-4 shadow-lg sm:left-auto sm:max-w-md">
      <p class="text-sm text-gray-700">Allow optional analytics and advertising Providers? First-party activity follows this shop's published policy.</p>
      <div class="mt-3 flex gap-2">
        <button data-consent="accept" class="rounded bg-gray-900 px-3 py-2 text-sm text-white">Allow</button>
        <button data-consent="decline" class="rounded border px-3 py-2 text-sm">Decline</button>
      </div>
    </aside>
    <script>
      import { createChaosClient } from "../lib/chaos";

      const consentKey = "chaos.storefront.analytics_consent";
      const banner = document.querySelector("#analytics-consent");
      const analytics = createChaosClient().analytics;
      const analyticsProductId = document.body.dataset.analyticsProductId;
      const privacyMode =
        import.meta.env.PUBLIC_CHAOS_ANALYTICS_PRIVACY_MODE === "opt_in" ? "opt_in" : "opt_out";
      if (privacyMode === "opt_out" && analyticsProductId) {
        analytics?.viewContent({ productId: analyticsProductId });
      }
      const applyConsent = (allowed: boolean) => {
        analytics?.setConsent({
          analyticsStorage: allowed,
          advertisingStorage: allowed,
          policyVersion: "storefront-v1",
        });
        if (allowed && privacyMode === "opt_in") {
          analytics?.start();
          analytics?.pageView();
          if (analyticsProductId) analytics?.viewContent({ productId: analyticsProductId });
        }
        banner?.classList.add("hidden");
      };
      const stored = localStorage.getItem(consentKey);
      if (stored === "accepted") applyConsent(true);
      else if (stored === "declined") applyConsent(false);
      else banner?.classList.remove("hidden");
      if (privacyMode === "opt_out") {
        const message = banner?.querySelector("p");
        if (message) message.textContent = "Analytics is enabled for this shop. You can opt out at any time.";
        const keep = banner?.querySelector('[data-consent="accept"]');
        const optOut = banner?.querySelector('[data-consent="decline"]');
        if (keep) keep.textContent = "Keep enabled";
        if (optOut) optOut.textContent = "Opt out";
      }
      banner?.querySelector('[data-consent="accept"]')?.addEventListener("click", () => {
        localStorage.setItem(consentKey, "accepted");
        applyConsent(true);
      });
      banner?.querySelector('[data-consent="decline"]')?.addEventListener("click", () => {
        localStorage.setItem(consentKey, "declined");
        applyConsent(false);
      });
    </script>
  </body>
</html>
