# Store-scoped publishable key. Safe to expose in the browser by design (see
# packages/js), and must use the PUBLIC_ prefix so Astro/Vite includes it in
# the client bundle for the cart/checkout React islands. Required.
PUBLIC_CHAOS_PUBLISHABLE_KEY=pk_test_...

# Store API origin, e.g. "https://shop.example.com/store/v1". Required: this
# SSR app's server-rendered pages call the Store API from Node, and Node's
# fetch cannot resolve a same-origin relative URL the way a browser can.
PUBLIC_CHAOS_STORE_API_BASE_URL=http://localhost:8080/store/v1

# Browser collection defaults to opt_out: Chaos, GA4, and Meta Pixel start
# immediately when configured and stop if the shopper opts out.
PUBLIC_CHAOS_ANALYTICS_PRIVACY_MODE=opt_out

# Optional browser Provider adapters. PUBLIC_META_PIXEL_ID must identify the
# same Meta Dataset configured for the Store's CAPI connection.
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_MEASUREMENT_ID=
