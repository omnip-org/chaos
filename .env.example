APP_BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://chaos:chaos@localhost:55432/chaos
DATABASE_CONTROL_PLANE_URL=postgres://chaos:chaos@localhost:55432/chaos
DATABASE_MAX_CONNECTIONS=20
DATABASE_CONTROL_PLANE_MAX_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_MS=2000
DATABASE_RUNTIME_ROLE=chaos_runtime
DATABASE_CONTROL_PLANE_ROLE=chaos_control_plane
REDIS_URL=redis://localhost:56379/0
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8080
AUTH_PUBLIC_BASE_URL=http://localhost:8080
SMTP_URL=smtp://localhost:51025
EMAIL_FROM=Chaos <no-reply@localhost>
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
STRIPE_API_BASE_URL=https://api.stripe.com/
SHOPPER_TOKEN_ACTIVE_KEY_ID=v1
SHOPPER_TOKEN_ACTIVE_SECRET=replace-with-at-least-32-random-bytes
# SHOPPER_TOKEN_PREVIOUS_KEY_ID=v0
# SHOPPER_TOKEN_PREVIOUS_SECRET=previous-key-kept-during-overlap-rotation
# Optional OTLP/HTTP trace collector endpoint, for example http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DEPENDENCY_TIMEOUT_MS=1000
SHUTDOWN_DRAIN_DELAY_MS=5000
SHUTDOWN_WORKER_TIMEOUT_MS=30000
RUST_LOG=chaos=debug,tower_http=info
LOG_JSON=false
